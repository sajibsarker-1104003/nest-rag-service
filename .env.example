# --- Observe (NestJS Observe telemetry, optional) ---
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Databases (Prisma 8, two databases) ---
USERS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/users_db?schema=public"
DOCS_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/docs_db?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- App ---
PORT=8080

# --- Embeddings: local OpenAI-compatible server (no key needed) ---
EMBEDDING_BASE_URL="http://localhost:8091/v1"
EMBEDDING_MODEL="deepvk/USER-bge-m3"   # must output 1024 dimensions

# --- Chat: any OpenAI-compatible endpoint (Groq free tier works) ---
CHAT_BASE_URL="https://api.groq.com/openai/v1"
CHAT_API_KEY=
CHAT_MODEL="openai/gpt-oss-120b"
